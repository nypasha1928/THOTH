FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
COPY --from=wheelhouse / /wheels
RUN pip install --no-cache-dir --no-index --find-links=/wheels -r requirements.txt && useradd --create-home --uid 10001 thoth
COPY --chown=thoth:thoth thoth ./thoth
COPY --chown=thoth:thoth web ./web
COPY --chown=thoth:thoth tools ./tools
COPY --chown=thoth:thoth reference ./reference
COPY --chown=thoth:thoth watchlist.json .
RUN mkdir -m 0700 /app/data && chown thoth:thoth /app/data
USER thoth
EXPOSE 8080
HEALTHCHECK --interval=15s --timeout=5s --start-period=10s --retries=3 CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/healthz', timeout=3)"
CMD ["python", "-m", "uvicorn", "thoth.app:app", "--host", "0.0.0.0", "--port", "8080", "--workers", "1", "--forwarded-allow-ips", "*"]
